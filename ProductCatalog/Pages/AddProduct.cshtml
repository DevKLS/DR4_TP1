
@page
@model ProductCatalog.Pages.AddProductModel

@{
    ViewData["Title"] = "Adicionar Produto";
}

<div class="container mt-4">
    <h1>Adicionar Produto</h1>

    <form method="post">

        <div class="mb-3">
            <label asp-for="Name" class="form-label">
                Nome do produto
            </label>

            <input asp-for="Name" class="form-control"
                   placeholder="Digite o nome do produto" />
        </div>

        <div class="mb-3">
            <label asp-for="Price" class="form-label">
                Preço
            </label>

            <input asp-for="Price" type="number"
                   step="0.01" min="0.01"
                   class="form-control"
                   placeholder="Digite o preço" />
        </div>

        <button type="submit" class="btn btn-primary">
            Cadastrar Produto
        </button>

    </form>

    <div asp-validation-summary="All"
         class="text-danger mt-3">
    </div>

    @if (Model.ProductAdded)
    {
        <div class="alert alert-success mt-4">
            <h4>Produto cadastrado com sucesso!</h4>

            <p><strong>Nome:</strong> @Model.Name</p>

            <p>
                <strong>Preço:</strong>
                R$ @Model.Price.ToString("F2")
            </p>
        </div>
    }
</div>
